{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/handoff.mjs\" upkeep --install",
            "timeout": 60,
            "statusMessage": "Upkeep: format, manifest, version, reinstall"
          }
        ]
      }
    ]
  }
}
