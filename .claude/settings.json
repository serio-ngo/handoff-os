{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(npm publish *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh release create *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/logo*)",
      "Edit(**/favicon*)",
      "Edit(**/brand-kit*)",
      "Edit(**/og-image*)"
    ]
  }
}
