{
  "name": "handoff-os",
  "version": "1.6.0",
  "description": "An egress lock, a verification gate, an audit trail and budget caps for Claude Code. Sends, payments, publishes, merges, deletes and credential writes stop before they run. No model call, no API key, no telemetry, no dependencies.",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/serio-ngo/handoff-os#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/serio-ngo/handoff-os.git"
  },
  "bugs": {
    "url": "https://github.com/serio-ngo/handoff-os/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node --test",
    "setup": "node scripts/handoff.mjs setup",
    "sync": "node scripts/handoff.mjs sync",
    "install:plugin": "node scripts/handoff.mjs install",
    "upkeep": "node scripts/handoff.mjs upkeep",
    "upkeep:check": "node scripts/handoff.mjs upkeep --check",
    "doctor": "node scripts/handoff.mjs doctor",
    "release": "node scripts/handoff.mjs release",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:eval": "node scripts/benchmark.mjs --eval",
    "benchmark:compare": "node scripts/benchmark.mjs --eval --compare --write",
    "benchmark:replay": "node scripts/benchmark.mjs --replay --write",
    "benchmark:ab": "node scripts/benchmark.mjs ab"
  }
}
