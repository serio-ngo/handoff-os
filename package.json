{
  "name": "handoff-os",
  "version": "1.10.1",
  "description": "An egress lock, a verification gate, an audit trail and budget caps for Claude Code. Sends, payments, publishes, merges, deletes and credential writes stop before they run. No model call, no API key, no telemetry, no dependencies.",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/serio-ngo/handoff-os#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/serio-ngo/handoff-os.git"
  },
  "bugs": {
    "url": "https://github.com/serio-ngo/handoff-os/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node --test",
    "setup": "node tooling/cli/handoff.mjs setup",
    "sync": "node tooling/cli/handoff.mjs sync",
    "install:plugin": "node tooling/cli/handoff.mjs install",
    "upkeep": "node tooling/cli/handoff.mjs upkeep",
    "upkeep:check": "node tooling/cli/handoff.mjs upkeep --check",
    "doctor": "node tooling/cli/handoff.mjs doctor",
    "release": "node tooling/cli/handoff.mjs release",
    "benchmark": "node tooling/benchmark/benchmark.mjs",
    "benchmark:eval": "node tooling/benchmark/benchmark.mjs --eval",
    "benchmark:compare": "node tooling/benchmark/benchmark.mjs --eval --compare --write",
    "benchmark:replay": "node tooling/benchmark/benchmark.mjs --replay --write",
    "benchmark:ab": "node tooling/benchmark/benchmark.mjs ab",
    "benchmark:flood": "node tooling/benchmark/benchmark.mjs flood"
  }
}
