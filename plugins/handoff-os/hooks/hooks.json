{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/card.mjs\"", "timeout": 10, "statusMessage": "Session card" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/card.mjs\"", "timeout": 10, "statusMessage": "Session card backup" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Bash|PowerShell|Edit|Write|Task|Agent|Workflow|Grep|Glob|mcp__)",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"", "timeout": 10, "statusMessage": "Egress lock, read budget, fan-out cap" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|mcp__(?!.*[_-](search|list|read|get|help|resolve)(_|-|$)))",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/audit.mjs\"", "timeout": 10, "statusMessage": "Audit receipt" }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "scout$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify.mjs\"", "timeout": 10, "statusMessage": "Scout citation contract" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify.mjs\"", "timeout": 15, "statusMessage": "Verify gate" }]
      }
    ]
  }
}
