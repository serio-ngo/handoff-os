{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/card.mjs\"", "timeout": 10, "statusMessage": "Session card" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Bash|PowerShell|Edit|Write|NotebookEdit|MultiEdit|Task|Agent|Workflow|Grep|Glob|mcp__)",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"", "timeout": 10, "statusMessage": "Egress lock, read budget, fan-out cap" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify.mjs\"", "timeout": 15, "statusMessage": "Verify gate" }]
      }
    ]
  }
}
