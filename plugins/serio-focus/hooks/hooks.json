{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/card.mjs\"", "timeout": 10, "statusMessage": "Session card" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Bash|PowerShell|Edit|Write|NotebookEdit|MultiEdit|Task|Agent|Workflow|Grep|Glob|mcp__)",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"", "timeout": 10, "statusMessage": "Fan-out cap, read budget, git lock" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|NotebookEdit|MultiEdit|mcp__(?!.*[_-](search|list|read|get|help|resolve)(_|-|$)))",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/audit.mjs\"", "timeout": 10, "statusMessage": "Audit receipt" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify.mjs\"", "timeout": 15, "statusMessage": "Session receipt" }]
      }
    ]
  }
}
